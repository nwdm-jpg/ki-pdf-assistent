# Vorlage für lokale Umgebungsvariablen - NUR Variablennamen/Platzhalter,
# NIEMALS echte Secrets. Kopiere diese Datei zu ".env" (oder setze die
# Variablen anderweitig in deiner Umgebung) und trage dort deine eigenen,
# echten Werte ein. ".env" selbst ist über .gitignore ausgeschlossen und
# darf NIE committet werden.

# --- OpenAI (Pflicht für alle KI-Funktionen: Chat, Analyse, Prüfung) ---
OPENAI_API_KEY=

# --- E-Mail-Versand (optional - ohne Provider bleibt der Entwicklungsmodus
# aktiv, der keine echten E-Mails versendet, siehe email_versand.py) ---
CLEVORIQ_EMAIL_PROVIDER=dev
RESEND_API_KEY=
CLEVORIQ_EMAIL_FROM=
CLEVORIQ_EMAIL_REPLY_TO=
CLEVORIQ_APP_BASE_URL=http://localhost:8501

# --- Zwei-Faktor-Authentifizierung (Pflicht, sobald ein Konto 2FA nutzen
# soll - siehe zwei_faktor_krypto.py; erzeugen mit:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ) ---
CLEVORIQ_2FA_ENCRYPTION_KEY=

# Vorlage für lokale Umgebungsvariablen - NUR Variablennamen/Platzhalter,
# NIEMALS echte Secrets. Kopiere diese Datei zu ".env" (oder setze die
# Variablen anderweitig in deiner Umgebung) und trage dort deine eigenen,
# echten Werte ein. ".env" selbst ist über .gitignore ausgeschlossen und
# darf NIE committet werden.

# --- OpenAI (Pflicht für alle KI-Funktionen: Chat, Analyse, Prüfung) ---
OPENAI_API_KEY=

# --- E-Mail-Versand (optional - ohne Provider bleibt der Entwicklungsmodus
# aktiv, der keine echten E-Mails versendet, siehe email_versand.py) ---
CLEVORIQ_EMAIL_PROVIDER=dev
RESEND_API_KEY=
CLEVORIQ_EMAIL_FROM=
CLEVORIQ_EMAIL_REPLY_TO=
CLEVORIQ_APP_BASE_URL=http://localhost:8501

# --- Zwei-Faktor-Authentifizierung (Pflicht, sobald ein Konto 2FA nutzen
# soll - siehe zwei_faktor_krypto.py; erzeugen mit:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ) ---
CLEVORIQ_2FA_ENCRYPTION_KEY=

# --- Datenbank-Backend (optional - Standard "sqlite" bleibt bis auf
# Weiteres das einzige vollständig unterstützte Backend, siehe
# db_backend.py/CLAUDE.md. "postgresql" ist als Verbindungsziel
# vorbereitet, aber Schema/Abfragen sind noch nicht portiert - ein
# künftiger Architekturblock schließt das ab.) ---
CLEVORIQ_DATABASE_BACKEND=sqlite
# Nur relevant, wenn CLEVORIQ_DATABASE_BACKEND=postgresql - Format
# z. B. "postgresql://benutzer:passwort@host:5432/datenbank". NIEMALS
# einen echten Wert hier eintragen oder committen.
CLEVORIQ_DATABASE_URL=

# --- Datei-Storage-Backend (optional - Standard "local" speichert
# Dokumente weiterhin unter app_daten/, siehe storage.py/CLAUDE.md.
# "s3" ist für einen S3-kompatiblen Object-Storage-Anbieter wie IONOS
# Object Storage vorbereitet - der Bucket bleibt dabei vollständig
# privat, es gibt keine öffentlichen Lese-URLs.) ---
CLEVORIQ_STORAGE_BACKEND=local
# Nur relevant, wenn CLEVORIQ_STORAGE_BACKEND=s3 - NIEMALS echte Werte
# hier eintragen oder committen.
CLEVORIQ_S3_ENDPOINT=
CLEVORIQ_S3_REGION=
CLEVORIQ_S3_BUCKET=
CLEVORIQ_S3_ACCESS_KEY_ID=
CLEVORIQ_S3_SECRET_ACCESS_KEY=
